{
  "name": "EST Parameter Sweep",
  "datasets": [
    {
      "id": "isdc_n",
      "path": "../data/isdc_n.json",
      "label": "SDC North"
    },
    {
      "id": "isdc_s",
      "path": "../data/isdc_s.json",
      "label": "SDC South"
    }
  ],
  "algorithms": [
    {
      "kind": "est",
      "axes": {
        "endangered_thresholds": [0, 5, 10],
        "k_beams": [1, 5, 10],
        "branching_factors": [1, 5, 10],
        "foms": ["soft_constraint", "future_flexibility"]
      }
    }
  ],
  "output_dir": "../out/est/"
}
