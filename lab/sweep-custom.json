{
  "name": "custom-comparison",
  "output_dir": "out/custom-comparison",
  "max_parallel": 22,

  "datasets": [
    {
      "id": "isdc_n",
      "path": "datasets/isdc_n.json",
      "label": "ISDC North"
    },
    {
      "id": "isdc_s",
      "path": "datasets/isdc_s.json",
      "label": "ISDC South"
    }
  ],

  "algorithms": [
    {
      "kind": "est",
      "axes": {
        "endangered_thresholds": [0, 1, 2],
        "k_beams": [1, 2],
        "branching_factors": [1, 2],
        "foms": [
            "soft_constraint",
            "future_flexibility"
        ]
      }
    },
    {
      "kind": "lst",
      "axes": {
        "endangered_thresholds": [1, 2],
        "k_beams": [1, 2],
        "branching_factors": [1, 2],
        "foms": [
            "soft_constraint",
            "future_flexibility"
        ]
      }
    }
  ]
}
