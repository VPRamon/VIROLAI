{
  "name": "custom-comparison",
  "output_dir": "out/custom-comparison",
  "max_parallel": 22,

  "datasets": [
    {
      "id": "isdc_n",
      "path": "datasets/isdc_n.json",
      "label": "ISDC North"
    },
    {
      "id": "isdc_s",
      "path": "datasets/isdc_s.json",
      "label": "ISDC South"
    },
    {
      "id": "lst_2024",
      "path": "datasets/lst_2024.json",
      "label": "LST 2024"
    },
    {
      "id": "lst_2025",
      "path": "datasets/lst_2025.json",
      "label": "LST 2025"
    },
    {
      "id": "lst_2026",
      "path": "datasets/lst_2026.json",
      "label": "LST 2026"
    }
  ],

  "algorithms": [
    {
      "kind": "est",
      "axes": {
        "endangered_thresholds": [1, 2, 4, 8, 16],
        "k_beams": [1, 2, 4, 8, 16],
        "branching_factors": [1, 2, 4, 8, 16],
        "foms": [
          "soft_constraint"
        ]
      }
    },
    {
      "kind": "lst",
      "axes": {
        "endangered_thresholds": [1, 2, 4, 8, 16],
        "k_beams": [1, 2, 4, 8, 16],
        "branching_factors": [1, 2, 4, 8, 16],
        "foms": [
          "soft_constraint"
        ]
      }
    },
    {
      "kind": "multi_cursor",
      "axes": {
        "layouts": [
          "est_lst_split",
          "four_quarter_forward"
        ],
        "endangered_thresholds": [1, 2, 4, 8, 16],
        "k_beams": [1, 2, 4, 8, 16],
        "branching_factors": [1, 2, 4, 8, 16],
        "foms": [
          "soft_constraint"
        ]
      }
    }
  ]
}
