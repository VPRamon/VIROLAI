{
  "name": "fast-comparison",
  "output_dir": "out/fast-comparison",
  "max_parallel": 16,

  "datasets": [
    {
      "id": "isdc_n",
      "path": "data/isdc_n.json",
      "label": "ISDC North"
    }
  ],

  "algorithms": [
    {
      "kind": "est",
      "axes": {
        "endangered_thresholds": [0, 1, 2],
        "k_beams": [1, 2, 4],
        "branching_factors": [1, 2],
        "foms": [
            "soft_constraint",
            "future_flexibility"
        ]
      }
    },
    {
      "kind": "lst",
      "axes": {
        "endangered_thresholds": [0, 1, 2],
        "k_beams": [1, 2, 4],
        "branching_factors": [1, 2],
        "foms": [
            "soft_constraint",
            "future_flexibility"
        ]
      }
    }
  ]
}