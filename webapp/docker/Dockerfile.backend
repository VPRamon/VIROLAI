# VIROLAI-TSI backend Dockerfile
# Builds the custom backend binary that adapts VIROLAI scheduling_problem payloads to TSI.
#
# Uses cargo-chef + BuildKit cache mounts to keep cold rebuilds fast and
# avoid rebuilding the dependency graph when only application sources
# change. Requires DOCKER_BUILDKIT=1 (default in modern Docker).
# syntax=docker/dockerfile:1.6

# ---------- Stage 1: chef base ----------
FROM rust:1-slim-bookworm AS chef
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq-dev pkg-config build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install --locked cargo-chef

# ---------- Stage 2: planner ----------
FROM chef AS planner
COPY Cargo.toml Cargo.lock* /app/
COPY schedulers/Cargo.toml /app/schedulers/Cargo.toml
COPY lab/Cargo.toml /app/lab/Cargo.toml
COPY webapp/Cargo.toml /app/webapp/Cargo.toml
COPY webapp/TSI/backend/Cargo.toml webapp/TSI/backend/Cargo.lock* webapp/TSI/backend/
COPY webapp/TSI/backend/src webapp/TSI/backend/src
COPY siderust /app/siderust
COPY schedulers/src /app/schedulers/src
COPY lab/src /app/lab/src
COPY webapp/src /app/webapp/src
RUN cargo chef prepare --recipe-path recipe.json

# ---------- Stage 3: builder ----------
FROM chef AS builder
# cargo-chef cook must locate all local path dependencies to validate manifests.
# Both siderust and tsi_rust are local path deps, so copy their full source
# trees before cooking. Registry crates are pre-built by cook; app-only sources
# (webapp/src, schemas) come after to preserve layer caching.
COPY Cargo.toml Cargo.lock* /app/
COPY siderust /app/siderust
COPY schedulers/Cargo.toml /app/schedulers/Cargo.toml
COPY lab/Cargo.toml /app/lab/Cargo.toml
COPY webapp/Cargo.toml /app/webapp/Cargo.toml
COPY webapp/TSI/backend/Cargo.toml webapp/TSI/backend/Cargo.lock* webapp/TSI/backend/
COPY webapp/TSI/backend/src webapp/TSI/backend/src
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo chef cook --release --recipe-path recipe.json -p webapp --bin webapp

COPY siderust /app/siderust
COPY Cargo.toml Cargo.lock* /app/
COPY schedulers/Cargo.toml /app/schedulers/Cargo.toml
COPY lab/Cargo.toml /app/lab/Cargo.toml
COPY webapp/Cargo.toml /app/webapp/Cargo.toml
COPY webapp/TSI/backend/Cargo.toml webapp/TSI/backend/Cargo.lock* webapp/TSI/backend/
COPY schedulers/src /app/schedulers/src
COPY lab/src /app/lab/src
COPY webapp/src /app/webapp/src
COPY webapp/TSI/backend/src /app/webapp/TSI/backend/src
COPY schemas /app/schemas

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo clean -p siderust -p schedulers -p tsi-rust -p webapp && \
    cargo build --release -p webapp --bin webapp \
    && cp target/release/webapp /usr/local/bin/webapp

# ---------- Stage 4: runtime ----------
FROM debian:bookworm-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/webapp /usr/local/bin/webapp

RUN useradd -r -s /bin/false virolai \
    && mkdir -p /data/experiments /data/workspaces \
    && chown virolai:virolai /data/experiments /data/workspaces
USER virolai

ENV VIROLAI_EXPERIMENTS_DIR=/data/experiments \
    VIROLAI_WORKSPACES_DIR=/data/workspaces

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["webapp"]
