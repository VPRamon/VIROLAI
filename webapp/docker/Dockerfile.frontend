# PhD-TSI frontend Dockerfile
# Builds the TSI React frontend from the submodule and serves it via nginx.
# syntax=docker/dockerfile:1.6

# Stage 1: build
FROM node:20-alpine AS builder

WORKDIR /app/webapp/TSI/frontend

COPY webapp/TSI/frontend/package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline --no-audit --no-fund
RUN ln -s /app/webapp/TSI/frontend/node_modules /app/webapp/node_modules

COPY webapp/TSI/frontend/ ./
COPY webapp/phd-extensions/ /app/webapp/phd-extensions/
RUN npm run build

# Stage 2: runtime
FROM nginx:alpine

COPY webapp/TSI/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/webapp/TSI/frontend/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
