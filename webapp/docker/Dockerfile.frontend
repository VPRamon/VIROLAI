# PhD-TSI frontend Dockerfile
# Builds the TSI React frontend from the submodule and serves it via nginx.

# Stage 1: build
FROM node:20-alpine AS builder

WORKDIR /app

COPY webapp/TSI/frontend/package*.json ./
RUN npm ci

COPY webapp/TSI/frontend/ ./
RUN npm run build

# Stage 2: runtime
FROM nginx:alpine

COPY webapp/TSI/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
