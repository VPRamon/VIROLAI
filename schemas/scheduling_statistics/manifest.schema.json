{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VPRamon/PhD/schemas/scheduling_statistics/manifest.schema.json",
  "title": "PhD Scheduler Manifest",
  "description": "Lightweight, versioned manifest emitted by the PhD CLI for one scheduler run. Heavy artifacts (full schedule, traces) are referenced by URI + SHA-256 instead of embedded.",
  "type": "object",
  "required": [
    "manifest_schema_version",
    "manifest_id",
    "created_at",
    "producer",
    "dataset",
    "algorithm",
    "run",
    "horizon",
    "metrics",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_schema_version": {
      "type": "string",
      "description": "SemVer of the manifest schema. Major bumps are breaking.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "manifest_id": {
      "type": "string",
      "description": "UUID (preferably v7) generated by the producer.",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC timestamp of when the manifest was created."
    },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "git_sha": { "type": ["string", "null"] },
        "host": { "type": ["string", "null"] }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["id", "name", "source_path", "sha256", "schema_version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "schema_version": { "type": "string", "minLength": 1 }
      }
    },
    "algorithm": {
      "type": "object",
      "required": ["id", "label", "version", "config"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "config": {}
      }
    },
    "run": {
      "type": "object",
      "required": ["run_id", "kind", "started_at", "finished_at", "status", "exit_code"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["single", "matrix_cell"] },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["completed", "failed", "skipped", "partial"] },
        "exit_code": { "type": "integer" }
      }
    },
    "horizon": {
      "$ref": "../scheduling_block/time.schema.json#/definitions/TimeWindow"
    },
    "metrics": {
      "$ref": "schedule_metrics.schema.json"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": { "$ref": "#/$defs/artifactRef" },
        "trace": { "$ref": "#/$defs/artifactRef" },
        "problem": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tsi_schedule_id": { "type": ["integer", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matrix_run_id": { "type": ["string", "null"] },
        "cell_id": { "type": ["string", "null"] },
        "parent_manifest": { "type": ["string", "null"] },
        "repo_root": { "type": ["string", "null"] },
        "cli_args": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["valid", "warning", "invalid"] },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message", "severity"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string" },
              "severity": { "type": "string", "enum": ["error", "warning"] }
            }
          }
        }
      }
    },
    "extensions": {
      "description": "Reserved namespace for additive, non-breaking extensions. Readers must ignore unknown keys here.\n\nReserved subkey `workspace_context` carries cohort-grouping hints used by the webapp `/workspace` UI:\n  - `observatory_id` (string): observatory the run targeted; consumed for cohort grouping when present.\n  - `period` ({ start_mjd_utc, end_mjd_utc }): scheduling period; falls back to the manifest `horizon` when absent.\n  - `block_pool_hash` (hex SHA-256 string): stable hash of the sorted block-id list used as scheduler input; used to detect equivalent input pools across runs.\n  - `block_count` (uint): number of input blocks the scheduler considered.\n\nManifests without `workspace_context` are grouped into a fallback cohort keyed by `(dataset_id, horizon.start_mjd_utc, horizon.end_mjd_utc)`.",
      "type": ["object", "null"]
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["uri", "size_bytes", "sha256", "media_type"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "media_type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
