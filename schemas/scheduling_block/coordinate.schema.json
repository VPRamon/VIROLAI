{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "scheduling_block/coordinate.schema.json",
  "title": "Coordinate Definitions",
  "description": "Common coordinate and location definitions.",
  "definitions": {
    "IcrsTarget": {
      "type": "object",
      "required": ["ra_deg", "dec_deg"],
      "additionalProperties": false,
      "properties": {
        "ra_deg": {
          "description": "Right ascension in degrees [0, 360).",
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "dec_deg": {
          "description": "Declination in degrees [-90, 90].",
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "GeodeticLocation": {
      "type": "object",
      "required": ["longitude_deg", "latitude_deg", "height_m"],
      "additionalProperties": false,
      "properties": {
        "longitude_deg": {
          "description": "Geodetic longitude in degrees (east positive).",
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude_deg": {
          "description": "Geodetic latitude in degrees.",
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "height_m": {
          "description": "Geodetic ellipsoidal height above WGS84 in meters.",
          "type": "number"
        }
      }
    }
  }
}
