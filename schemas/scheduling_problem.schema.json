{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "scheduling_problem.schema.json",
  "title": "SchedulingProblem",
  "description": "Scheduler problem payload containing a geodetic location, global scheduling horizon, and scheduling blocks.",
  "type": "object",
  "required": ["location", "schedule_time_window", "scheduling_blocks"],
  "additionalProperties": false,
  "properties": {
    "location": {
      "$ref": "#/$defs/Location"
    },
    "schedule_time_window": {
      "$ref": "#/$defs/TimeWindow"
    },
    "scheduling_blocks": {
      "$ref": "scheduling_blocks.schema.json"
    }
  },
  "$defs": {
    "Location": {
      "type": "object",
      "required": ["longitude_deg", "latitude_deg", "height_m"],
      "additionalProperties": false,
      "properties": {
        "longitude_deg": {
          "description": "Geodetic longitude in degrees (east positive).",
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude_deg": {
          "description": "Geodetic latitude in degrees.",
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "height_m": {
          "description": "Geodetic ellipsoidal height above WGS84 in meters.",
          "type": "number"
        }
      }
    },
    "TimeWindow": {
      "type": "object",
      "required": ["start_mjd_utc", "end_mjd_utc"],
      "additionalProperties": false,
      "properties": {
        "start_mjd_utc": {
          "description": "Inclusive UTC start in Modified Julian Date.",
          "type": "number"
        },
        "end_mjd_utc": {
          "description": "Exclusive UTC end in Modified Julian Date.",
          "type": "number"
        }
      }
    }
  }
}
