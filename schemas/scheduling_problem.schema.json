{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "scheduling_problem.schema.json",
  "title": "SchedulingProblem",
  "description": "Scheduler problem payload containing telescope resources, a global scheduling horizon, and scheduling blocks.",
  "type": "object",
  "required": ["resources", "schedule_time_window", "scheduling_blocks"],
  "additionalProperties": false,
  "properties": {
    "resources": {
      "description": "Available telescope resources that can execute scheduled tasks.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Telescope"
      }
    },
    "schedule_time_window": {
      "$ref": "#/$defs/TimeWindow"
    },
    "scheduling_blocks": {
      "$ref": "scheduling_blocks.schema.json"
    }
  },
  "$defs": {
    "Location": {
      "type": "object",
      "required": ["longitude_deg", "latitude_deg", "height_m"],
      "additionalProperties": false,
      "properties": {
        "longitude_deg": {
          "description": "Geodetic longitude in degrees (east positive).",
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude_deg": {
          "description": "Geodetic latitude in degrees.",
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "height_m": {
          "description": "Geodetic ellipsoidal height above WGS84 in meters.",
          "type": "number"
        }
      }
    },
    "Telescope": {
      "type": "object",
      "required": ["id", "location"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique numeric identifier for the telescope resource.",
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "description": "Human-readable label for this telescope.",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "hard_constraints": {
          "description": "Hard observability constraints specific to this telescope.",
          "$ref": "hard_constraints.schema.json"
        },
        "soft_constraints": {
          "description": "Soft scoring constraints specific to this telescope.",
          "$ref": "soft_constraints.schema.json"
        }
      }
    },
    "TimeWindow": {
      "type": "object",
      "required": ["start_mjd_utc", "end_mjd_utc"],
      "additionalProperties": false,
      "properties": {
        "start_mjd_utc": {
          "description": "Inclusive UTC start in Modified Julian Date.",
          "type": "number"
        },
        "end_mjd_utc": {
          "description": "Exclusive UTC end in Modified Julian Date.",
          "type": "number"
        }
      }
    }
  }
}
