{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "task.schema.json",
  "title": "Task",
  "type": "object",
  "required": ["id", "requested_duration_sec"],
  "properties": {
    "id": {
      "description": "Unique numeric identifier for the task.",
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "description": "Human-readable label for this task.",
      "type": "string"
    },
    "requested_duration_sec": {
      "description": "Minimum requested observation duration in seconds.",
      "type": "number",
      "minimum": 0
    },
    "target": {
      "description": "Celestial target for this task in the ICRS frame.",
      "$ref": "#/$defs/IcrsTarget"
    },
    "hard_constraints": {
      "description": "Hard observability constraints for this task.",
      "$ref": "hard_constraints.schema.json"
    },
    "soft_constraints": {
      "description": "Soft scoring constraints for this task.",
      "$ref": "soft_constraints.schema.json"
    }
  },
  "$defs": {
    "IcrsTarget": {
      "type": "object",
      "required": ["ra_deg", "dec_deg"],
      "additionalProperties": false,
      "properties": {
        "ra_deg": {
          "description": "Right ascension in degrees [0, 360).",
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "dec_deg": {
          "description": "Declination in degrees [-90, 90].",
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    }
  }
}
