{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "scheduling_problem/telescope.schema.json",
  "title": "Telescope",
  "type": "object",
  "required": ["id", "location"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Unique numeric identifier for the telescope resource.",
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "description": "Human-readable label for this telescope.",
      "type": "string"
    },
    "location": {
      "$ref": "../scheduling_block/coordinate.schema.json#/definitions/GeodeticLocation"
    },
    "hard_constraints": {
      "description": "Hard observability constraints specific to this telescope.",
      "$ref": "../scheduling_block/hard_constraints.schema.json"
    },
    "soft_constraints": {
      "description": "Soft scoring constraints specific to this telescope.",
      "$ref": "../scheduling_block/soft_constraints.schema.json"
    }
  }
}
