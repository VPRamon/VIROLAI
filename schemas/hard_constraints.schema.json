{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "hard_constraints.schema.json",
  "title": "HardConstraints",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "altitude_min_deg": {
      "description": "Minimum target altitude above horizon in degrees.",
      "type": "number",
      "minimum": 0,
      "maximum": 90
    },
    "altitude_max_deg": {
      "description": "Maximum target altitude above horizon in degrees.",
      "type": "number",
      "minimum": 0,
      "maximum": 90
    },
    "azimuth_min_deg": {
      "description": "Minimum target azimuth in degrees [0, 360).",
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "azimuth_max_deg": {
      "description": "Maximum target azimuth in degrees (0, 360].",
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "time_window": {
      "description": "Fixed time window in which the task must be scheduled.",
      "$ref": "#/$defs/TimeWindow"
    },
    "night_time": {
      "description": "Restrict feasibility to nighttime based on a siderust twilight threshold.",
      "$ref": "#/$defs/NightTimeConstraint"
    },
    "moon_altitude": {
      "description": "Restrict Moon altitude bounds; use max <= 0 to enforce Moon below horizon.",
      "$ref": "#/$defs/MoonAltitudeConstraint"
    }
  },
  "$defs": {
    "Twilight": {
      "type": "string",
      "enum": [
        "Civil",
        "Nautical",
        "Astronomical",
        "Horizon",
        "ApparentHorizon"
      ],
      "description": "siderust Twilight enum variant used as the solar altitude threshold."
    },
    "NightTimeConstraint": {
      "type": "object",
      "required": ["twilight"],
      "additionalProperties": false,
      "properties": {
        "twilight": {
          "$ref": "#/$defs/Twilight"
        }
      }
    },
    "MoonAltitudeConstraint": {
      "type": "object",
      "required": ["min_deg", "max_deg"],
      "additionalProperties": false,
      "properties": {
        "min_deg": {
          "description": "Minimum allowed Moon altitude in degrees.",
          "type": "number",
          "minimum": -90,
          "maximum": 0
        },
        "max_deg": {
          "description": "Maximum allowed Moon altitude in degrees (must be <= horizon).",
          "type": "number",
          "minimum": -90,
          "maximum": 0
        }
      }
    },
    "TimeWindow": {
      "type": "object",
      "required": ["start_mjd_utc", "end_mjd_utc"],
      "additionalProperties": false,
      "properties": {
        "start_mjd_utc": {
          "description": "Window start as Modified Julian Date (UTC scale).",
          "type": "number"
        },
        "end_mjd_utc": {
          "description": "Window end as Modified Julian Date (UTC scale).",
          "type": "number"
        }
      }
    }
  }
}
