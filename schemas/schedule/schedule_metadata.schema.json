{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "schedule/schedule_metadata.schema.json",
  "title": "ScheduleMetadata",
  "description": "Algorithm and run metadata embedded alongside an annotated schedule.",
  "allOf": [
    {
      "$ref": "../scheduling_algorithms/algorithm.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "location": {
          "$ref": "../scheduling_block/coordinate.schema.json#/definitions/GeodeticLocation"
        },
        "period": {
          "$ref": "../scheduling_block/time.schema.json#/definitions/TimeWindow"
        }
      }
    }
  ]
}
