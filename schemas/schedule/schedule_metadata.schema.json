{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "schedule/schedule_metadata.schema.json",
  "title": "ScheduleMetadata",
  "description": "Algorithm and run metadata embedded alongside an annotated schedule.",
  "allOf": [
    {
      "$ref": "../scheduling_algorithms/algorithm.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "location": {
          "$ref": "../scheduling_problem/telescope.schema.json#/$defs/Location"
        },
        "period": {
          "$ref": "#/$defs/PeriodMeta"
        }
      }
    }
  ],
  "$defs": {
    "PeriodMeta": {
      "type": "object",
      "required": ["start_mjd_utc", "end_mjd_utc"],
      "additionalProperties": false,
      "properties": {
        "start_mjd_utc": {
          "description": "Inclusive UTC start in Modified Julian Date.",
          "type": "number"
        },
        "end_mjd_utc": {
          "description": "Exclusive UTC end in Modified Julian Date.",
          "type": "number"
        }
      }
    }
  }
}
