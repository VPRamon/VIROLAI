{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "schedule/schedule.schema.json",
  "title": "Schedule",
  "description": "Annotated schedule output preserving the scheduling problem envelope and augmenting tasks with placement metadata.",
  "type": "object",
  "required": ["resources", "schedule_time_window", "scheduling_blocks"],
  "additionalProperties": false,
  "properties": {
    "resources": {
      "description": "Available telescope resources carried through from the original problem.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../scheduling_problem/telescope.schema.json"
      }
    },
    "schedule_time_window": {
      "$ref": "#/$defs/TimeWindow"
    },
    "scheduling_blocks": {
      "$ref": "scheduling_blocks.schema.json"
    },
    "schedule_metadata": {
      "$ref": "schedule_metadata.schema.json"
    }
  },
  "$defs": {
    "TimeWindow": {
      "type": "object",
      "required": ["start_mjd_utc", "end_mjd_utc"],
      "additionalProperties": false,
      "properties": {
        "start_mjd_utc": {
          "description": "Inclusive UTC start in Modified Julian Date.",
          "type": "number"
        },
        "end_mjd_utc": {
          "description": "Exclusive UTC end in Modified Julian Date.",
          "type": "number"
        }
      }
    }
  }
}
